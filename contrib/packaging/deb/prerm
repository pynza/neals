#!/bin/bash
# Stop/disable the instance enabled by postinst (dpkg prerm / rpm %preun).
set -e

STATE_USER="/var/lib/neals/deb-user"

# deb: remove|upgrade|deconfigure | rpm %preun: 0=uninstall, >=1=upgrade
case "$1" in
remove|upgrade|deconfigure|0|1)
  if command -v systemctl >/dev/null 2>&1; then
    if [[ -f "$STATE_USER" ]]; then
      user="$(cat "$STATE_USER")"
      if [[ -n "$user" ]]; then
        # Stop daemon first so it writes an empty hosts mirror, then apply once
        # to clear the neals block from /etc/hosts before disabling the path unit.
        systemctl stop "nealsd@${user}.service" 2>/dev/null || true
        systemctl start neals-hosts-sync.service 2>/dev/null || true
        systemctl disable "nealsd@${user}.service" 2>/dev/null || true
        rm -rf "/etc/systemd/system/nealsd@${user}.service.d"
      fi
    fi
    systemctl disable --now neals-hosts-sync.path 2>/dev/null || true
    systemctl stop neals-hosts-sync.service 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
  fi
  ;;
esac

exit 0
