#!/bin/bash
# Maintainer script after package install (dpkg postinst / rpm %post).
# Enables nealsd@$SUDO_USER (portless :80) and shell completion.
# Skip with NEALS_DEB_SETUP=0 or NEALS_PKG_SETUP=0.
set -e

COMPLETION_BEGIN="# >>> neals completions >>>"
COMPLETION_END="# <<< neals completions <<<"
# Test seams: override to exercise the script without touching the host.
STATE_DIR="${NEALS_STATE_DIR:-/var/lib/neals}"
STATE_USER="$STATE_DIR/deb-user"
SYSTEMCTL="${NEALS_SYSTEMCTL:-systemctl}"
SYSTEMD_RUN_DIR="${NEALS_SYSTEMD_RUN_DIR:-/run/systemd/system}"

ask_yes_no() {
  local prompt="$1" reply
  case "${NEALS_PKG_SETUP:-${NEALS_DEB_SETUP:-}}" in
    0|n|N|no|NO) return 1 ;;
    1|y|Y|yes|YES) return 0 ;;
  esac
  if [[ "${DEBIAN_FRONTEND:-}" == "noninteractive" ]]; then
    return 0
  fi
  if [[ -r /dev/tty ]]; then
    read -r -p "$prompt" reply </dev/tty || reply=y
  elif [[ -t 0 ]]; then
    read -r -p "$prompt" reply || reply=y
  else
    return 0
  fi
  case "$reply" in
    ""|y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

setup_user_completion() {
  local user="$1" home shell_name rc snippet
  home="$(getent passwd "$user" | cut -d: -f6)"
  shell_name="$(basename "$(getent passwd "$user" | cut -d: -f7)")"
  case "$shell_name" in
    bash)
      # System file /usr/share/bash-completion/completions/neals covers bash.
      return 0
      ;;
    zsh)
      rc="$home/.zshrc"
      snippet='source <(COMPLETE=zsh neals)'
      ;;
    fish)
      rc="$home/.config/fish/config.fish"
      snippet='COMPLETE=fish neals | source'
      ;;
    *)
      return 0
      ;;
  esac
  if [[ -f "$rc" ]] && grep -qF "$COMPLETION_BEGIN" "$rc" 2>/dev/null; then
    return 0
  fi
  if [[ "$shell_name" == "fish" ]]; then
    install -d -o "$user" -g "$(id -gn "$user")" "$(dirname "$rc")"
  fi
  if [[ ! -e "$rc" ]]; then
    touch "$rc"
    chown "$user:$(id -gn "$user")" "$rc"
    chmod 644 "$rc"
  fi
  {
    echo ""
    echo "$COMPLETION_BEGIN"
    echo "$snippet"
    echo "$COMPLETION_END"
  } >>"$rc"
  chown "$user:$(id -gn "$user")" "$rc"
  echo "neals: shell completion added to $rc"
}

enable_daemon() {
  local user="$1" first_install="$2"
  if ! command -v "$SYSTEMCTL" >/dev/null 2>&1; then
    echo "neals: $SYSTEMCTL not found; skip daemon enable" >&2
    return 0
  fi
  if [[ ! -d "$SYSTEMD_RUN_DIR" ]]; then
    echo "neals: systemd not active; skip daemon enable" >&2
    return 0
  fi

  "$SYSTEMCTL" daemon-reload || true

  # PATH for ~/.nix-profile is in the vendor unit (/home/%i); /etc drop-ins are
  # left to the administrator and are never written or removed by the package.
  # Enable only on first install: on upgrade respect an explicit `systemctl
  # disable` — postinst's try-restart already refreshed a running daemon.
  if [[ "$first_install" == "1" ]]; then
    "$SYSTEMCTL" enable --now "nealsd@${user}.service"
  fi
  # Host DNS: path unit watches /run/neals/hosts (written by nealsd) and merges /etc/hosts.
  if [[ -f /usr/lib/systemd/system/neals-hosts-sync.path ]]; then
    if [[ "$first_install" == "1" ]]; then
      "$SYSTEMCTL" enable --now neals-hosts-sync.path 2>/dev/null || true
      echo "neals: enabled neals-hosts-sync.path (auto /etc/hosts aliases)"
    fi
    # Pick up a fragment that already exists (reinstall / upgrade).
    "$SYSTEMCTL" start neals-hosts-sync.service 2>/dev/null || true
  fi
  mkdir -p "$STATE_DIR"
  echo "$user" >"$STATE_USER"
  if [[ "$first_install" == "1" ]]; then
    echo "neals: enabled nealsd@${user} (prefers :80, falls back if busy)"
  else
    echo "neals: upgraded nealsd@${user} (enablement unchanged)"
  fi
}

# deb: configure | rpm %post: 1=install, 2=upgrade
case "$1" in
configure|1|2)
  # deb configure: $2 is the previous version (empty on first install, but also
  # non-empty after `dpkg -r` + reinstall — postrm leaves a marker for that).
  # rpm %post: 1=install, 2=upgrade.
  FIRST_INSTALL=0
  case "${1:-}" in
    configure)
      if [[ -z "${2:-}" || -f "$STATE_DIR/reinstall" ]]; then FIRST_INSTALL=1; fi
      ;;
    1) FIRST_INSTALL=1 ;;
  esac
  if [[ "$FIRST_INSTALL" == "1" ]]; then
    rm -f "$STATE_DIR/reinstall"
  fi

  if command -v "$SYSTEMCTL" >/dev/null 2>&1 && [[ -d "$SYSTEMD_RUN_DIR" ]]; then
    "$SYSTEMCTL" daemon-reload || true
    # prerm no longer stops the daemon on upgrade: pick up the new binary in
    # place. try-restart is a no-op if it was not running. Use the recorded
    # user so unattended upgrades work without SUDO_USER in the environment.
    if [[ -f "$STATE_USER" ]]; then
      saved_user="$(cat "$STATE_USER" 2>/dev/null || true)"
      if [[ -n "$saved_user" ]]; then
        "$SYSTEMCTL" try-restart "nealsd@${saved_user}.service" 2>/dev/null || true
      fi
    fi
  fi

  USER_NAME="${SUDO_USER:-}"
  if [[ -z "$USER_NAME" || "$USER_NAME" == "root" ]]; then
    echo "neals: installed. Enable the portless daemon with:"
    echo "  sudo systemctl enable --now \"nealsd@\$USER\""
    echo "neals: bash completion: /usr/share/bash-completion/completions/neals"
    echo "neals: guest→host loopback is off by default; see docs/services.md (NEALS_ALLOW_HOST_LOOPBACK)."
    exit 0
  fi

  if ! id "$USER_NAME" >/dev/null 2>&1; then
    exit 0
  fi

  echo "neals: configuring for user ${USER_NAME}"
  action="Configure"
  if [[ "$FIRST_INSTALL" == "1" ]]; then action="Enable"; fi
  if ask_yes_no "$action nealsd@${USER_NAME} (*.localhost; prefers :80), host DNS sync, and shell completion? [Y/n] "; then
    enable_daemon "$USER_NAME" "$FIRST_INSTALL"
    setup_user_completion "$USER_NAME"
    echo "neals: try: neals doctor"
  else
    echo "neals: skipped. Later:"
    echo "  sudo systemctl enable --now \"nealsd@${USER_NAME}\""
    echo "  sudo systemctl enable --now neals-hosts-sync.path"
    echo "  neals completions zsh   # if needed"
  fi
  ;;
esac

exit 0
