[Unit]
Description=Neals local platform daemon (%i)
Documentation=file:///usr/local/share/doc/neals/systemd.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
Group=%i

# :80 for Caddy (inherited by the child). Do not set NoNewPrivileges — bwrap needs userns.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

RuntimeDirectory=neals
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run

Environment=NEALS_MODE=system
Environment=NEALS_CADDY_HTTP_ADDR=127.0.0.1:80

# Override path: systemctl edit nealsd@USER
ExecStart=/usr/local/bin/nealsd
Restart=on-failure
RestartSec=2

PrivateTmp=true

[Install]
WantedBy=multi-user.target
