[Unit]
Description=Neals local platform daemon (%i)
Documentation=file:///usr/local/share/doc/neals/systemd.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
Group=%i

# Classic Unix pattern: the daemon (not every user process) may bind :80.
# AmbientCapabilities is inherited by the Caddy child nealsd spawns.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Socket at /run/neals/nealsd.sock (CLI prefers this over $XDG_RUNTIME_DIR).
RuntimeDirectory=neals
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run

# Portless URLs: http://{service}.{project}.localhost/
Environment=NEALS_MODE=system
Environment=NEALS_CADDY_HTTP_ADDR=127.0.0.1:80

# Override at install time if binaries live elsewhere:
#   systemctl edit nealsd@USER
ExecStart=/usr/local/bin/nealsd
Restart=on-failure
RestartSec=2

# Harden a bit; keep the rest of the user environment (HOME, PATH for nix/devenv).
PrivateTmp=true

[Install]
WantedBy=multi-user.target
