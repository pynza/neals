[Unit]
Description=Apply Neals host DNS aliases to /etc/hosts
Documentation=file:///usr/local/share/doc/neals/systemd.md
After=local-fs.target
ConditionPathExists=/run/neals/hosts
# Never wedge the path unit if the daemon rewrites the mirror in a burst.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# Serialize concurrent triggers (up/down races).
ExecStart=/usr/local/bin/neals hosts apply --from /run/neals/hosts
